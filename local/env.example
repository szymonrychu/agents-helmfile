# Copy to .env at the repo root (cp local/env.example .env) and fill in. Never commit .env.

# Harbor pull credentials for harbor.szymonrichert.pl.
HARBOR_USERNAME=
# Harbor pull password.
HARBOR_PASSWORD=
# Claude Code OAuth token handed to the agents.
CLAUDE_CODE_OAUTH_TOKEN=
# Comma-separated profile names to generate tokens for (empty: defaults).
AGENTS_LOCAL_PROFILES=
# true or false: seed the docker-in-docker option (empty: true).
AGENTS_LOCAL_DIND=
# Number of hives to start (empty: 1).
AGENTS_LOCAL_HIVES=
# Host port for the HTTP ingress on 127.0.0.1 (empty: 8080).
AGENTS_LOCAL_HTTP_PORT=
# true to use a fake claude instead of the real one (empty: false).
AGENTS_LOCAL_FAKE_CLAUDE=
