# All releases live in namespace `agents`, which helm creates on first install
# (the hook also pre-creates it so raw/regcred.pre.secrets.yaml can land first).
repositories:
  - name: cnpg
    url: https://cloudnative-pg.github.io/charts

helmDefaults:
  wait: true
  syncArgs:
    - --rollback-on-failure

templates:
  default: &default
    missingFileHandler: Warn
    hooks:
    - events:
      - prepare
      - presync
      - postsync
      showlogs: true
      command: ./.hook.sh
      args:
      - '{{`{{ exec "pwd" (list) }}`}}'
      - '{{`{{ .Event.Name }}`}}'
      - '{{`{{ .Release.Name }}`}}'
      - '{{`{{ .Release.Namespace }}`}}'
      - '{{`{{ .Release.Version }}`}}'
      - '{{`{{ .Release.Timeout | default 600 }}`}}'
    values:
    - values/common.yaml
    - values/{{`{{ .Release.Name }}`}}/common.yaml
    - values/{{`{{ .Release.Name }}`}}/default.yaml
    secrets:
    - values/{{`{{ .Release.Name }}`}}/default.secrets.yaml

releases:
  - name: agent-orchestrator-db
    namespace: agents
    chart: cnpg/cluster
    version: 0.9.0
    # helm --force would delete and recreate the Cluster CR and is incompatible
    # with Helm 4 server-side apply.
    force: false
    timeout: 600
    labels:
      purpose: agents
      application: agent-orchestrator
    <<: *default

  - name: agents-orchestrator-db
    namespace: agents
    chart: cnpg/cluster
    version: 0.9.0
    # Imports the data of agent-orchestrator-db (design D1); the old release stays.
    force: false
    timeout: 600
    labels:
      purpose: agents
      application: agents-orchestrator
    <<: *default

  # Retired by the rename to agents-orchestrator (design D7): apply uninstalls it.
  - name: agent-orchestrator
    namespace: agents
    chart: oci://harbor.szymonrichert.pl/charts/agent-orchestrator
    installed: false

  - name: agents-orchestrator
    namespace: agents
    chart: oci://harbor.szymonrichert.pl/charts/agents-orchestrator
    version: 0.1.0-main.bba074f
    timeout: 600
    needs:
      - agents/agents-orchestrator-db
    labels:
      purpose: agents
      application: agents-orchestrator
    <<: *default
    # Overrides the default anchor's list: the service token hash file comes after default.
    secrets:
    - values/agents-orchestrator/default.secrets.yaml
    - values/agents-orchestrator/service-token-agents-webhook.secrets.yaml

  - name: agents-webhook-db
    namespace: agents
    chart: cnpg/cluster
    version: 0.9.0
    force: false
    timeout: 600
    labels:
      purpose: agents
      application: agents-webhook
    <<: *default

  - name: agents-schedule-db
    namespace: agents
    chart: cnpg/cluster
    version: 0.9.0
    force: false
    timeout: 600
    labels:
      purpose: agents
      application: agents-schedule
    <<: *default

  - name: agents-webhook
    namespace: agents
    chart: oci://harbor.szymonrichert.pl/charts/agents-webhook
    version: 0.1.0-main.838ba1f
    timeout: 600
    needs:
      - agents/agents-webhook-db
      - agents/agents-orchestrator
    labels:
      purpose: agents
      application: agents-webhook
    <<: *default

  - name: agents-web
    namespace: agents
    chart: oci://harbor.szymonrichert.pl/charts/agents-web
    version: 0.1.0-main.5a8d6c8
    timeout: 600
    needs:
      - agents/agents-webhook
    labels:
      purpose: agents
      application: agents-web
    <<: *default
