# All releases live in namespace `agents`, which helm creates on first install
# (the hook also pre-creates it so raw/regcred.pre.secrets.yaml can land first).
repositories:
  - name: cnpg
    url: https://cloudnative-pg.github.io/charts

helmDefaults:
  wait: true
  syncArgs:
    - --rollback-on-failure

templates:
  default: &default
    missingFileHandler: Warn
    hooks:
    - events:
      - prepare
      - presync
      - postsync
      showlogs: true
      command: ./.hook.sh
      args:
      - '{{`{{ exec "pwd" (list) }}`}}'
      - '{{`{{ .Event.Name }}`}}'
      - '{{`{{ .Release.Name }}`}}'
      - '{{`{{ .Release.Namespace }}`}}'
      - '{{`{{ .Release.Version }}`}}'
      - '{{`{{ .Release.Timeout | default 600 }}`}}'
    values:
    - values/common.yaml
    - values/{{`{{ .Release.Name }}`}}/common.yaml
    - values/{{`{{ .Release.Name }}`}}/default.yaml
    secrets:
    - values/{{`{{ .Release.Name }}`}}/default.secrets.yaml

releases:
  - name: agent-orchestrator-db
    namespace: agents
    chart: cnpg/cluster
    version: 0.9.0
    # helm --force would delete and recreate the Cluster CR and is incompatible
    # with Helm 4 server-side apply.
    force: false
    timeout: 600
    labels:
      purpose: agents
      application: agent-orchestrator
    <<: *default

  - name: agents-orchestrator-db
    namespace: agents
    chart: cnpg/cluster
    version: 0.9.0
    # Imports the data of agent-orchestrator-db (design D1); the old release stays.
    force: false
    timeout: 600
    labels:
      purpose: agents
      application: agents-orchestrator
    <<: *default

  # Retired by the rename to agents-orchestrator (design D7): apply uninstalls it.
  - name: agent-orchestrator
    namespace: agents
    chart: oci://harbor.szymonrichert.pl/charts/agent-orchestrator
    installed: false

  - name: agents-orchestrator
    namespace: agents
    chart: oci://harbor.szymonrichert.pl/charts/agents-orchestrator
    version: 0.1.0-main.d21da00
    timeout: 600
    needs:
      - agents/agents-orchestrator-db
    labels:
      purpose: agents
      application: agents-orchestrator
    <<: *default
    # Overrides the default anchor's list: the service, usage and chat token files come after default.
    secrets:
    - values/agents-orchestrator/default.secrets.yaml
    - values/agents-orchestrator/service-token-agents-webhook.secrets.yaml
    - values/agents-orchestrator/service-token-agents-schedule.secrets.yaml
    - values/agents-orchestrator/service-token-agents-matrix-connector.secrets.yaml
    - values/agents-orchestrator/service-token-agents-usage.secrets.yaml
    - values/agents-orchestrator/service-token-agents-taskboard.secrets.yaml
    - values/agents-orchestrator/usage-token.secrets.yaml
    - values/agents-orchestrator/chat-token.secrets.yaml
    - values/agents-orchestrator/taskboard-token.secrets.yaml
    - values/agents-orchestrator/history-token.secrets.yaml
    - values/agents-orchestrator/service-token-agents-app-connector.secrets.yaml

  - name: agents-webhook-db
    namespace: agents
    chart: cnpg/cluster
    version: 0.9.0
    force: false
    timeout: 600
    labels:
      purpose: agents
      application: agents-webhook
    <<: *default

  - name: agents-matrix-connector-db
    namespace: agents
    chart: cnpg/cluster
    version: 0.9.0
    force: false
    timeout: 600
    labels:
      purpose: agents
      application: agents-matrix-connector
    <<: *default

  - name: agents-schedule-db
    namespace: agents
    chart: cnpg/cluster
    version: 0.9.0
    force: false
    timeout: 600
    labels:
      purpose: agents
      application: agents-schedule
    <<: *default

  - name: agents-usage-db
    namespace: agents
    chart: cnpg/cluster
    version: 0.9.0
    force: false
    timeout: 600
    labels:
      purpose: agents
      application: agents-usage
    <<: *default

  - name: agents-history-db
    namespace: agents
    chart: cnpg/cluster
    version: 0.9.0
    force: false
    timeout: 600
    labels:
      purpose: agents
      application: agents-history
    <<: *default

  - name: agents-taskboard-db
    namespace: agents
    chart: cnpg/cluster
    version: 0.9.0
    force: false
    timeout: 600
    labels:
      purpose: agents
      application: agents-taskboard
    <<: *default

  - name: agents-app-connector-db
    namespace: agents
    chart: cnpg/cluster
    version: 0.9.0
    force: false
    timeout: 600
    labels:
      purpose: agents
      application: agents-app-connector
    <<: *default

  - name: agents-webhook
    namespace: agents
    chart: oci://harbor.szymonrichert.pl/charts/agents-webhook
    version: 0.1.0-main.f720309
    timeout: 600
    needs:
      - agents/agents-webhook-db
      - agents/agents-orchestrator
    labels:
      purpose: agents
      application: agents-webhook
    <<: *default

  - name: agents-schedule
    namespace: agents
    chart: oci://harbor.szymonrichert.pl/charts/agents-schedule
    version: 0.1.0-main.e918156
    timeout: 600
    needs:
      - agents/agents-schedule-db
      - agents/agents-orchestrator
    labels:
      purpose: agents
      application: agents-schedule
    <<: *default

  - name: agents-taskboard
    namespace: agents
    chart: oci://harbor.szymonrichert.pl/charts/agents-taskboard
    version: 0.1.0-main.aa558da
    timeout: 600
    needs:
      - agents/agents-taskboard-db
      - agents/agents-orchestrator
    labels:
      purpose: agents
      application: agents-taskboard
    <<: *default
    # Overrides the default anchor's list: the relay token file comes after default.
    secrets:
    - values/agents-taskboard/default.secrets.yaml
    - values/agents-taskboard/relay-token.secrets.yaml

  - name: agents-app-connector
    namespace: agents
    chart: oci://harbor.szymonrichert.pl/charts/agents-app-connector
    version: 0.1.0-main.b86c8e3
    timeout: 600
    needs:
      - agents/agents-app-connector-db
      - agents/agents-orchestrator
    labels:
      purpose: agents
      application: agents-app-connector
    <<: *default

  - name: agents-usage
    namespace: agents
    chart: oci://harbor.szymonrichert.pl/charts/agents-usage
    version: 0.1.0-main.40be11c
    timeout: 600
    needs:
      - agents/agents-usage-db
      - agents/agents-orchestrator
    labels:
      purpose: agents
      application: agents-usage
    <<: *default

  - name: agents-history
    namespace: agents
    chart: oci://harbor.szymonrichert.pl/charts/agents-history
    version: 0.1.0-main.e6a1f6d
    timeout: 600
    needs:
      - agents/agents-history-db
    labels:
      purpose: agents
      application: agents-history
    <<: *default

  - name: agents-matrix-connector
    namespace: agents
    chart: oci://harbor.szymonrichert.pl/charts/agents-matrix-connector
    version: 0.1.0-main.d2a145f
    timeout: 600
    needs:
      - agents/agents-matrix-connector-db
      - agents/agents-orchestrator
    labels:
      purpose: agents
      application: agents-matrix-connector
    <<: *default
    # Overrides the default anchor's list: the agent token hash file comes after default.
    secrets:
    - values/agents-matrix-connector/default.secrets.yaml
    - values/agents-matrix-connector/agent-token.secrets.yaml

  - name: agents-web
    namespace: agents
    chart: oci://harbor.szymonrichert.pl/charts/agents-web
    version: 0.1.0-main.f1003f8
    timeout: 600
    needs:
      - agents/agents-webhook
      - agents/agents-matrix-connector
    labels:
      purpose: agents
      application: agents-web
    <<: *default
